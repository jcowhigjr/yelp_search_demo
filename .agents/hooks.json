{
  "model-monitor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/model_check.py --pre-invocation",
        "timeout": 5
      }
    ]
  },
  "git-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/model_check.py --pre-tool-use",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

